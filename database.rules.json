{
  "rules": {
    "productStats": {
      ".read": true,
      "$productId": {
        ".write": true,
        ".validate": "newData.hasChildren()",
        "views": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "purchases": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "daily": {
          "$day": {
            "views": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "referrers": {
              "$referrer": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              }
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "adminProducts": {
      ".read": true,
      ".write": "auth.token.admin === true"
    },
    "trashedProducts": {
      ".read": "auth.token.admin === true",
      ".write": "auth.token.admin === true"
    },
    "categories": {
      ".read": true,
      ".write": "auth.token.admin === true"
    },
    "collections": {
      ".read": true,
      ".write": "auth.token.admin === true"
    },
    "subcategories": {
      ".read": true,
      ".write": "auth.token.admin === true"
    },
    "settings": {
      ".read": true,
      ".write": "auth.token.admin === true"
    },
    "fileMetadata": {
      ".read": "auth.token.admin === true",
      ".write": "auth.token.admin === true"
    },
    "orders": {
      ".read": "auth != null",
      "$orderId": {
        ".read": true,
        ".write": true
      }
    },
    "coupons": {
      ".read": true,
      "$code": {
        ".write": true,
        "usageCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "customerUsage": {
          "$customerId": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      }
    },
    "referrers": {
      ".read": "auth.token.admin === true",
      ".write": "auth.token.admin === true"
    },
    "jobs": {
      ".read": true,
      ".write": "auth.token.admin === true"
    },
    "feedback": {
      ".read": "auth.token.admin === true",
      ".write": true
    },
    "productFaqs": {
      ".read": true,
      ".write": "auth.token.admin === true"
    },
    "productReviews": {
      ".read": true,
      "$productId": {
        "$reviewId": {
          ".write": "auth != null || (!data.exists() && newData.exists())",
          ".validate": "newData.hasChildren(['name', 'rating', 'title', 'body', 'helpful', 'createdAtMs']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 60 && newData.child('rating').isNumber() && newData.child('rating').val() >= 1 && newData.child('rating').val() <= 5 && newData.child('rating').val() % 1 == 0 && newData.child('title').isString() && newData.child('title').val().length <= 100 && newData.child('body').isString() && newData.child('body').val().length >= 10 && newData.child('body').val().length <= 2000 && newData.child('createdAtMs').isNumber()",
          "helpful": {
            ".write": true,
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == 0) || (data.exists() && newData.val() == data.val() + 1))"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "checkoutFailures": {
      ".read": "auth.token.admin === true",
      ".write": true
    },
    ".read": false,
    ".write": false
  }
}
