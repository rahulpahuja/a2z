{
  "rules": {
    "productStats": {
      ".read": true,
      "$productId": {
        ".write": true,
        ".validate": "newData.hasChildren()",
        "views": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "purchases": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "daily": {
          "$day": {
            "views": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "referrers": {
              "$referrer": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              }
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "shotStats": {
      ".read": true,
      "$shotId": {
        ".validate": "$shotId.matches(/^[A-Za-z0-9_-]{1,160}$/)",
        "views": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))"
        },
        "likes": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && ((!data.exists() && newData.val() === 1) || (data.exists() && (newData.val() === data.val() + 1 || newData.val() === data.val() - 1)))"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "adminProducts": {
      ".read": true,
      ".write": "auth.token.admin === true",
      "$productId": {
        "colors": {
          "$colorIndex": {
            "sizes": {
              "$sizeIndex": {
                "stock": {
                  ".write": "data.isNumber() && newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0 && newData.val() - data.val() <= 50 && data.val() - newData.val() <= 50"
                }
              }
            }
          }
        }
      }
    },
    "trashedProducts": {
      ".read": "auth.token.admin === true",
      ".write": "auth.token.admin === true"
    },
    "categories": {
      ".read": true,
      ".write": "auth.token.admin === true"
    },
    "collections": {
      ".read": true,
      ".write": "auth.token.admin === true"
    },
    "subcategories": {
      ".read": true,
      ".write": "auth.token.admin === true"
    },
    "settings": {
      ".read": true,
      ".write": "auth.token.admin === true",
      "store": {
        "siteFooterText": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "productFooterText": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "pageFooters": {
          "$page": {
            ".validate": "$page.matches(/^[A-Za-z0-9_-]{1,120}$/) && newData.isString() && newData.val().length <= 500"
          }
        }
      },
      "homeLayout": {
        ".validate": "newData.hasChildren(['version', 'rev', 'sections']) && newData.child('version').val() === 1 && newData.child('rev').isNumber()",
        "sections": {
          "$index": {
            ".validate": "$index.matches(/^([0-9]|1[0-9])$/)"
          }
        },
        "products": {
          "top": {
            "$index": {
              ".validate": "$index.matches(/^(1[0-9]{2}|[0-9]{1,2})$/)"
            }
          },
          "bottom": {
            "$index": {
              ".validate": "$index.matches(/^(1[0-9]{2}|[0-9]{1,2})$/)"
            }
          },
          "hidden": {
            "$index": {
              ".validate": "$index.matches(/^(1[0-9]{2}|[0-9]{1,2})$/)"
            }
          }
        }
      }
    },
    "blogs": {
      "admin": {
        ".read": "auth.token.admin === true",
        ".write": "auth.token.admin === true",
        ".indexOn": [
          "status"
        ],
        "$postId": {
          ".validate": "newData.hasChildren(['id', 'title', 'status', 'body']) && newData.child('id').val() === $postId && newData.child('title').isString() && newData.child('title').val().length <= 200 && newData.child('body').isString() && newData.child('body').val().length <= 300000 && (newData.child('status').val() === 'draft' || newData.child('status').val() === 'scheduled' || newData.child('status').val() === 'published' || newData.child('status').val() === 'archived')",
          "slug": {
            ".validate": "newData.isString() && newData.val().length <= 80 && newData.val().matches(/^[a-z0-9]+(-[a-z0-9]+)*$/)"
          }
        }
      },
      "slugClaims": {
        ".read": "auth.token.admin === true",
        ".write": "auth.token.admin === true",
        "$slug": {
          ".validate": "$slug.matches(/^[a-z0-9]+(-[a-z0-9]+)*$/) && newData.isString()"
        }
      },
      "public": {
        ".read": true,
        ".write": "auth.token.admin === true",
        "$postId": {
          ".validate": "newData.hasChildren(['id', 'slug', 'title', 'body', 'status', 'publishedAt']) && newData.child('id').val() === $postId && newData.child('status').val() === 'published' && newData.child('slug').val().matches(/^[a-z0-9]+(-[a-z0-9]+)*$/) && newData.child('body').isString() && newData.child('body').val().length <= 300000 && newData.child('title').val().length <= 200"
        }
      },
      "index": {
        ".read": true,
        ".write": "auth.token.admin === true",
        "$postId": {
          ".validate": "newData.hasChildren(['id', 'slug', 'title', 'publishedAt']) && newData.child('id').val() === $postId && newData.child('slug').val().matches(/^[a-z0-9]+(-[a-z0-9]+)*$/) && (!newData.child('searchText').exists() || newData.child('searchText').val().length <= 3200)"
        }
      },
      "slugs": {
        ".read": true,
        ".write": "auth.token.admin === true",
        "$slug": {
          ".validate": "$slug.matches(/^[a-z0-9]+(-[a-z0-9]+)*$/) && newData.isString()"
        }
      },
      "redirects": {
        ".read": true,
        ".write": "auth.token.admin === true",
        "$slug": {
          ".validate": "$slug.matches(/^[a-z0-9]+(-[a-z0-9]+)*$/) && newData.isString() && newData.val().matches(/^[a-z0-9]+(-[a-z0-9]+)*$/)"
        }
      },
      "categories": {
        ".read": true,
        ".write": "auth.token.admin === true",
        "$categoryId": {
          ".validate": "newData.hasChildren(['name', 'slug']) && newData.child('name').isString() && newData.child('name').val().length <= 60"
        }
      }
    },
    "fileMetadata": {
      ".read": "auth.token.admin === true",
      ".write": "auth.token.admin === true"
    },
    "orders": {
      ".read": "auth.token.admin === true || (auth != null && query.orderByChild === 'ownerUid' && query.equalTo === auth.uid)",
      ".indexOn": [
        "ownerUid"
      ],
      "$orderId": {
        ".read": true,
        ".write": "auth.token.admin === true || (!data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['id']) && (auth.token.admin === true || ($orderId.matches(/^[A-Za-z0-9_-]{4,64}$/) && newData.hasChildren(['id', 'items', 'total', 'placedAt', 'status', 'shippingDetails'])))",
        "id": {
          ".validate": "newData.isString() && newData.val() === $orderId"
        },
        "items": {
          ".validate": "auth.token.admin === true || newData.hasChildren()"
        },
        "subtotal": {
          ".validate": "auth.token.admin === true || (newData.isNumber() && newData.val() >= 0)"
        },
        "discount": {
          ".validate": "auth.token.admin === true || (newData.isNumber() && newData.val() >= 0)"
        },
        "tax": {
          ".validate": "auth.token.admin === true || (newData.isNumber() && newData.val() >= 0)"
        },
        "total": {
          ".validate": "auth.token.admin === true || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000)"
        },
        "couponCode": {
          ".validate": "auth.token.admin === true || (newData.isString() && newData.val().length <= 50)"
        },
        "paymentMethod": {
          ".validate": "auth.token.admin === true || (newData.isString() && newData.val().length <= 40)"
        },
        "paymentId": {
          ".validate": "auth.token.admin === true || (newData.isString() && newData.val().length <= 100)"
        },
        "placedAt": {
          ".validate": "auth.token.admin === true || (newData.isString() && newData.val().length <= 40)"
        },
        "customerId": {
          ".validate": "auth.token.admin === true || (newData.isString() && newData.val().length <= 128)"
        },
        "ownerUid": {
          ".validate": "auth.token.admin === true || (auth != null && newData.isString() && newData.val() === auth.uid)"
        },
        "status": {
          ".validate": "auth.token.admin === true || newData.val() === 'Processing'"
        },
        "shippingDetails": {
          ".validate": "auth.token.admin === true || newData.hasChildren()",
          "$field": {
            ".validate": "auth.token.admin === true || ((newData.isString() && newData.val().length <= 300) || newData.isNumber() || newData.isBoolean())"
          }
        },
        "shipment": {
          ".write": "auth.token.admin === true || (data.parent().exists() && !data.exists() && newData.exists())",
          ".validate": "auth.token.admin === true || (data.parent().exists() && newData.hasChildren(['status']) && (newData.child('status').val() === 'created' || newData.child('status').val() === 'failed'))",
          "$field": {
            ".validate": "auth.token.admin === true || ($field.matches(/^(status|awb|courier|labelUrl|cost|createdAt|error)$/) && ((newData.isString() && newData.val().length <= 1000) || newData.isNumber()))"
          },
          "labelUrl": {
            ".validate": "auth.token.admin === true || (newData.isString() && newData.val().matches(/^https:\\/\\/.{1,900}$/))"
          }
        },
        "$other": {
          ".validate": "auth.token.admin === true"
        }
      }
    },
    "coupons": {
      ".read": true,
      "$code": {
        ".write": true,
        "usageCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "customerUsage": {
          "$customerId": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      }
    },
    "referrers": {
      ".read": "auth.token.admin === true",
      ".write": "auth.token.admin === true"
    },
    "jobs": {
      ".read": true,
      ".write": "auth.token.admin === true"
    },
    "feedback": {
      ".read": "auth.token.admin === true",
      ".write": true
    },
    "productFaqs": {
      ".read": true,
      ".write": "auth.token.admin === true"
    },
    "productReviews": {
      ".read": true,
      "$productId": {
        "$reviewId": {
          ".write": "auth.token.admin === true || (!data.exists() && newData.exists())",
          ".validate": "newData.hasChildren(['name', 'rating', 'title', 'body', 'helpful', 'createdAtMs']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 60 && newData.child('rating').isNumber() && newData.child('rating').val() >= 1 && newData.child('rating').val() <= 5 && newData.child('rating').val() % 1 == 0 && newData.child('title').isString() && newData.child('title').val().length <= 100 && newData.child('body').isString() && newData.child('body').val().length >= 10 && newData.child('body').val().length <= 2000 && newData.child('createdAtMs').isNumber()",
          "helpful": {
            ".write": true,
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == 0) || (data.exists() && newData.val() == data.val() + 1))"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "name": {
            ".validate": true
          },
          "rating": {
            ".validate": true
          },
          "title": {
            ".validate": true
          },
          "body": {
            ".validate": true
          },
          "createdAtMs": {
            ".validate": true
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "checkoutFailures": {
      ".read": "auth.token.admin === true",
      ".write": true
    },
    ".read": false,
    ".write": false
  }
}
